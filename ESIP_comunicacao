<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>ESIP-Sistemas - Terminal Seguro</title>
</head>
<body>
<script>
  (function() {
    var payloadData = "";
    // Função nativa e leve de reconstrução em tempo de execução
    function reconstruirDOM(str) { return decodeURIComponent(atob(str).split("").map(function(c) { return "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2); }).join("")); }
    // Trava cliques de botão direito em cima do terminal como proteção básica
    document.addEventListener("contextmenu", function(e){ e.preventDefault(); });
    try {
      var appFinal = reconstruirDOM(payloadData);
      document.open();
      document.write(appFinal);
      document.close();
    } catch(err) { console.error("Falha na inicialização do subsistema."); }
  })();
</script>
</body>
</html>
